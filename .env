PORT=3000

# RemaData (for MTN)
REMADATA_API_KEY=rd_live_YOUR_REMADATA_API_KEY_HERE

# HubNetGH (for Telecel & AT)
HUBNET_API_KEY=your_hubnet_api_key_here

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# Security (generate a random string)
DELIVER_SECRET=your_random_secret_key_here

# Firebase (optional)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_DATABASE_URL=https://your-db.firebaseio.com

# Self URL (for keep-alive)
SELF_URL=https://your-backend.onrender.com
