# ============================================================
#  DataFlow GH — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the actual .env file to version control.
# ============================================================

# Server
PORT=3000

# ── HubNet API ───────────────────────────────────────────────
# Your HubNet API key from https://hubnetgh.site
HUBNET_API_KEY=YOUR_HUBNET_API_KEY_HERE

# ── Paystack ─────────────────────────────────────────────────
# Secret key from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Firebase Admin SDK ───────────────────────────────────────
# Paste the ENTIRE contents of your Firebase service account JSON
# as a single-line string (use a JSON minifier if needed).
# Get it from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"stafford-2efd9","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@stafford-2efd9.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://stafford-2efd9-default-rtdb.firebaseio.com
