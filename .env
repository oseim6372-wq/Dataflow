# ============================================
# DATEFLOW GH - ENVIRONMENT VARIABLES
# ============================================

# Provider API Keys
REMADATA_API_KEY=your_remadata_api_key_here
HUBNET_API_KEY=your_hubnet_api_key_here

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=https://dataflow.kesug.com/wallet

# Security
DELIVER_SECRET=your_deliver_secret_key_here
PARTNER_API_SECRET=your_partner_secret_key_here

# Firebase Configuration
FIREBASE_DATABASE_URL=https://your-database.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server Configuration
PORT=3000
NODE_ENV=production
